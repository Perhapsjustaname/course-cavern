# Copy to .env.local only if you want to override something. For local
# development you can skip this file entirely: `npm run dev` creates
# .env.local on first run and fills in the values below for you.

# Signs session cookies. At least 32 characters. Generated on first run.
SESSION_SECRET=

# The first admin account, created on first run. The password is random and
# written to .env.local; look there when you need to sign in as admin.
SEED_ADMIN_EMAIL=admin@coursecavern.test
SEED_ADMIN_PASSWORD=

# Leave unset to use the built-in local database. Set it to point the app at
# any other Postgres 17 server instead.
# DATABASE_URL=postgresql://user:password@host:5432/course_cavern

# Port for the built-in local database, if 54329 clashes with something.
# LOCAL_DB_PORT=54329

# Not used yet. Needed once payments, email and cloud storage are wired up.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
SENDGRID_API_KEY=
MAIL_FROM=
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
