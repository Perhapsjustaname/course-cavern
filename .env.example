# Copy to .env.local for local development.
# The app runs without any of these set; they are needed once the database and
# external services are wired up.

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/course_cavern

# Stripe (test keys)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# SendGrid
SENDGRID_API_KEY=
MAIL_FROM=

# S3 compatible object storage
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
